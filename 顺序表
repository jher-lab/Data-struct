#define MaxSize 50          // 定义最大长度
typedef struct {
    ElemType data[MaxSize]; // 用静态数组存放数据元素
    int length;             // 顺序表的当前长度
} SqList;
#define InitSize 100
typedef struct {
    ElemType *data;         // 指示动态分配数组的指针
    int MaxSize, length;    // 数组的最大容量和当前个数
} SqList;
void InitList(SqList &L) {
    for (int i = 0; i < MaxSize; i++)
        L.data[i] = 0;      // 防止"脏数据"
    L.length = 0;
}
bool ListInsert(SqList &L, int i, ElemType e) {
    if (i < 1 || i > L.length + 1)   // 判断 i 的范围是否合法
        return false;
    if (L.length >= MaxSize)         // 存储空间已满
        return false;
    for (int j = L.length; j >= i; j--)  // 从最后一个元素开始后移
        L.data[j] = L.data[j - 1];
    L.data[i - 1] = e;             // 位序 i 对应下标 i-1
    L.length++;
    return true;
}
bool ListDelete(SqList &L, int i, ElemType &e) {
    if (i < 1 || i > L.length)     // 判断 i 的范围是否合法
        return false;
    e = L.data[i - 1];             // 将被删除元素赋值给 e
    for (int j = i; j < L.length; j++)  // 从第 i+1 个元素开始前移
        L.data[j - 1] = L.data[j];
    L.length--;
    return true;
}
ElemType GetElem(SqList L, int i) {   // 按位序查找
    return L.data[i - 1];
}

int LocateElem(SqList L, ElemType e) { // 按值查找，返回位序
    for (int i = 0; i < L.length; i++)
        if (L.data[i] == e)
            return i + 1;             // 返回位序
    return 0;                         // 查找失败
}
