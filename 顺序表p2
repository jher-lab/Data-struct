无辅助空间
void Reverse(int R[],int from,int to){
int i,temp;
for(int i = 0;i < (to-from)/2;i++){
temp = R[from+i];
R[from+i] = R[to-i];
R[to-i] = temp;
}
}
void(int R[],int n,int p){
Reverse(R,0,p-1);
Reverse(R,p,n-1);
Reverse(R,0,p-1);
}
